// Karmchari News — add these blocks inside your existing match /databases/{database}/documents { ... }
// Replace the email with the admin Google account(s) listed in js/config.js → adminEmails.
function knAdmin() {
  return request.auth != null && request.auth.token.email in ['surajbhanpandey853@gmail.com'];
}
match /knNews/{id} {
  allow read: if true;
  allow write: if knAdmin();
}
match /knConfig/{id} {
  allow read: if true;
  allow write: if knAdmin();
}
match /knUsers/{uid} {
  allow read, write: if request.auth != null && request.auth.uid == uid;
}

// Visitor analytics. Reads remain admin-only. Anonymous app writes may create
// a first count or increment both counters by exactly one; totals cannot be overwritten.
function knStatsId(id) {
  return id == 'total' || id.matches('^d[0-9]{4}-[0-9]{2}-[0-9]{2}$');
}
function knStatsShape(data) {
  return data.keys().hasOnly(['v', 'u'])
    && data.v is int && data.u is int
    && data.v >= 1 && data.u >= 0 && data.u <= data.v;
}
match /knStats/{id} {
  allow get: if knAdmin();
  allow list: if false;
  allow create: if knStatsId(id) && knStatsShape(request.resource.data)
    && request.resource.data.v == 1
    && request.resource.data.u in [0, 1];
  allow update: if knStatsId(id)
    && knStatsShape(resource.data) && knStatsShape(request.resource.data)
    && request.resource.data.v == resource.data.v + 1
    && request.resource.data.u in [resource.data.u, resource.data.u + 1];
  allow delete: if false;
}
