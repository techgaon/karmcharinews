// Karmchari News — add these blocks inside your existing  match /databases/{database}/documents { ... }
// Replace the email with the admin Google account(s) listed in js/config.js → adminEmails.
function knAdmin() {
  return request.auth != null && request.auth.token.email in ['surajbhanpandey853@gmail.com'];
}
match /knNews/{id} {
  allow read: if true;
  allow write: if knAdmin();
}
match /knConfig/{id} {
  allow read: if true;
  allow write: if knAdmin();
}
match /knUsers/{uid} {
  allow read, write: if request.auth != null && request.auth.uid == uid;
}

// Visitor analytics: only the signed-in Google admin may read counts.
// This is a rules FRAGMENT for the existing Firestore project, not a
// complete replacement. Add it inside match /databases/{database}/documents.
match /knStats/{id} {
  allow get: if knAdmin();
  allow list: if false;
  // The public client must not be able to modify visitor totals.
  // Count visits through a trusted backend using Firebase Admin SDK.
  allow create, update, delete: if false;
}
